# Where the app under test answers.
# Set: both suites use this address as given and start nothing.
# Unset: the cured suite starts its own app on a free port; the sick suite
# assumes something is already listening on 8100 (that assumption is one of
# the things wrong with it).
APP_URL=http://127.0.0.1:8100
# playwright (default) or selenium
UI_DRIVER=playwright
HEADLESS=true
# The board's render delay range, the one deliberate source of timing
RENDER_DELAY_MIN_MS=100
RENDER_DELAY_MAX_MS=700
